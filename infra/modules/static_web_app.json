{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "5692042523193833046"
    }
  },
  "parameters": {
    "staticSiteName": {
      "type": "string",
      "metadata": {
        "description": "Static Web App name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "tags": {
      "type": "object"
    }
  },
  "resources": {
    "swa": {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('staticSiteName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "repositoryUrl": "",
        "branch": "main",
        "buildProperties": {
          "appLocation": "frontend",
          "outputLocation": ".next",
          "appArtifactLocation": ".next"
        }
      },
      "sku": {
        "name": "Free",
        "tier": "Free"
      }
    }
  },
  "outputs": {
    "apiKey": {
      "type": "securestring",
      "value": "[listSecrets('swa', '2023-12-01').properties.apiKey]"
    },
    "defaultHostname": {
      "type": "string",
      "value": "[reference('swa').defaultHostname]"
    }
  }
}