{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "4590279518809036761"
    }
  },
  "parameters": {
    "primaryServerName": {
      "type": "string",
      "metadata": {
        "description": "Primary server name."
      }
    },
    "replicaServerName": {
      "type": "string",
      "metadata": {
        "description": "Read-replica server name."
      }
    },
    "administratorLogin": {
      "type": "string",
      "metadata": {
        "description": "Admin login for Postgres (NOT used by apps — they use this too today; rotate via Key Vault)."
      }
    },
    "administratorPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Admin password — provide via parameter file / Key Vault at deploy time."
      }
    },
    "postgresVersion": {
      "type": "string",
      "defaultValue": "16",
      "allowedValues": [
        "14",
        "15",
        "16"
      ]
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard_D4ds_v5",
      "metadata": {
        "description": "SKU name, e.g. Standard_D4ds_v5 (4 vCore / 16 GiB)."
      }
    },
    "storageSizeGB": {
      "type": "int",
      "defaultValue": 64,
      "metadata": {
        "description": "Storage size in GB."
      }
    },
    "publicNetworkAccess": {
      "type": "string",
      "defaultValue": "Disabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ],
      "metadata": {
        "description": "Whether the primary accepts public network traffic. Keep Disabled in production."
      }
    },
    "highAvailabilityMode": {
      "type": "string",
      "defaultValue": "None",
      "allowedValues": [
        "ZoneRedundant",
        "SameZone",
        "None"
      ],
      "metadata": {
        "description": "Zone-redundant HA for production; None for staging cost savings."
      }
    },
    "delegatedSubnetResourceId": {
      "type": "string"
    },
    "privateDnsZoneId": {
      "type": "string"
    },
    "databaseName": {
      "type": "string",
      "defaultValue": "attendance_db"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "tags": {
      "type": "object"
    }
  },
  "variables": {
    "storageAutoGrow": "Enabled",
    "maintenanceWindow": {
      "customWindow": "Enabled",
      "dayOfWeek": 6,
      "startHour": 2,
      "startMinute": 0
    }
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-03-01",
      "name": "[parameters('primaryServerName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('skuName')]",
        "tier": "GeneralPurpose"
      },
      "properties": {
        "version": "[parameters('postgresVersion')]",
        "administratorLogin": "[parameters('administratorLogin')]",
        "administratorLoginPassword": "[parameters('administratorPassword')]",
        "network": {
          "delegatedSubnetResourceId": "[parameters('delegatedSubnetResourceId')]",
          "privateDnsZoneArmResourceId": "[parameters('privateDnsZoneId')]",
          "publicNetworkAccess": "[parameters('publicNetworkAccess')]"
        },
        "storage": {
          "storageSizeGB": "[parameters('storageSizeGB')]",
          "autoGrow": "[variables('storageAutoGrow')]"
        },
        "backup": {
          "backupRetentionDays": 14,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "[parameters('highAvailabilityMode')]"
        },
        "maintenanceWindow": "[variables('maintenanceWindow')]"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', parameters('primaryServerName'), parameters('databaseName'))]",
      "properties": {
        "charset": "utf8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('primaryServerName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-03-01",
      "name": "[parameters('replicaServerName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('skuName')]",
        "tier": "GeneralPurpose"
      },
      "properties": {
        "createMode": "Replica",
        "sourceServerResourceId": "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('primaryServerName'))]",
        "version": "[parameters('postgresVersion')]",
        "network": {
          "delegatedSubnetResourceId": "[parameters('delegatedSubnetResourceId')]",
          "privateDnsZoneArmResourceId": "[parameters('privateDnsZoneId')]",
          "publicNetworkAccess": "[parameters('publicNetworkAccess')]"
        },
        "storage": {
          "autoGrow": "[variables('storageAutoGrow')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('primaryServerName'))]"
      ]
    }
  ],
  "outputs": {
    "primaryServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('primaryServerName')), '2024-03-01').fullyQualifiedDomainName]"
    },
    "replicaServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('replicaServerName')), '2024-03-01').fullyQualifiedDomainName]"
    },
    "primaryServerName": {
      "type": "string",
      "value": "[parameters('primaryServerName')]"
    }
  }
}