{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "14907167226973557136"
    }
  },
  "parameters": {
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Key Vault name (globally unique)."
      }
    },
    "identityPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "User-assigned managed identity principal id that may read secrets."
      }
    },
    "jwtSecret": {
      "type": "securestring"
    },
    "postgresConnectionString": {
      "type": "securestring"
    },
    "redisConnectionString": {
      "type": "securestring"
    },
    "serviceBusConnectionString": {
      "type": "securestring"
    },
    "storageConnectionString": {
      "type": "securestring"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "tags": {
      "type": "object"
    }
  },
  "variables": {
    "secrets": [
      {
        "name": "Database--ConnectionString",
        "value": "[parameters('postgresConnectionString')]"
      },
      {
        "name": "Redis--ConnectionString",
        "value": "[parameters('redisConnectionString')]"
      },
      {
        "name": "ServiceBus--ConnectionString",
        "value": "[parameters('serviceBusConnectionString')]"
      },
      {
        "name": "Storage--ConnectionString",
        "value": "[parameters('storageConnectionString')]"
      },
      {
        "name": "JwtSecret",
        "value": "[parameters('jwtSecret')]"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]"
      }
    },
    {
      "copy": {
        "name": "secretResources",
        "count": "[length(variables('secrets'))]"
      },
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), variables('secrets')[copyIndex()].name)]",
      "properties": {
        "value": "[variables('secrets')[copyIndex()].value]",
        "contentType": "text/plain"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), parameters('identityPrincipalId'), 'Key Vault Secrets User')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
        "principalId": "[parameters('identityPrincipalId')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
      ]
    }
  ],
  "outputs": {
    "vaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri]"
    },
    "vaultName": {
      "type": "string",
      "value": "[parameters('keyVaultName')]"
    }
  }
}