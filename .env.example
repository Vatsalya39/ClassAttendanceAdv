# ─────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# NEVER commit .env or any file containing real secrets to source control.
# In production, all secrets are pulled from Azure Key Vault via managed
# identity — this file is purely for local docker-compose / direct-run usage.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Full DSN for async SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://attendance:attendance@localhost:5432/attendance_db

# Sync DSN used by Alembic migrations only
DATABASE_URL_SYNC=postgresql+psycopg2://attendance:attendance@localhost:5432/attendance_db

# Async SQLAlchemy connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_random_hex_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Queue backend ─────────────────────────────────────────────────────────────
# "redis"         — local dev (uses Redis List via LPUSH/BRPOP)
# "servicebus"    — production (requires SERVICE_BUS_CONNECTION_STRING)
QUEUE_BACKEND=redis
QUEUE_NAME=capture-jobs

# Azure Service Bus (leave blank for local dev)
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_NAMESPACE=

# ── Storage backend ───────────────────────────────────────────────────────────
# "local"         — stores files under STORAGE_LOCAL_ROOT (for local dev)
# "azure_blob"    — production (requires AZURE_STORAGE_CONNECTION_STRING)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/data/uploads

# Azure Blob Storage (leave blank for local dev)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_ENROLLMENT=enrollment-images
AZURE_BLOB_CONTAINER_SESSIONS=session-images

# ── Azure Key Vault (production only) ─────────────────────────────────────────
# Managed identity must have "Key Vault Secrets User" role on this vault.
AZURE_KEYVAULT_URI=

# ── Face pipeline ─────────────────────────────────────────────────────────────
# Cosine distance threshold (0-2 scale). Values below this are a match.
# Calibrate with scripts/calibrate_threshold.py — default is conservative.
FACE_MATCH_THRESHOLD=0.45

# Required distance gap between best and runner-up DISTINCT student —
# smaller gaps (lookalikes/twins) go to the review queue, not auto-matched.
FACE_MATCH_MARGIN=0.08

# Nearest roster embeddings fetched per face (grouped by student; each
# student scored by mean of their top-2 embedding distances).
FACE_MATCH_TOP_K=10

# Distinct candidate students entering the 1-to-1 assignment cost matrix.
FACE_CANDIDATE_STUDENTS=5

# Max faces expected in a single classroom photo (guard against runaway loops)
FACE_DETECTION_MAX_FACES=100

# InsightFace model pack name (buffalo_l = RetinaFace + ArcFace 512-d;
# antelopev2 = better accuracy, larger download)
INSIGHTFACE_MODEL_PACK=buffalo_l

# ONNX Runtime execution providers, comma-separated (unavailable ones are
# silently dropped — safe on CPU-only machines)
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# Horizontal-flip test-time augmentation: embed face + mirror, average.
FACE_TTA_FLIP=true

# Session-photo detection input size (enrollment selfies stay at 640) —
# 1600 catches small back-row faces.
SESSION_DET_SIZE=1600

# Overlapping-tile detection for wide session photos (merged via NMS).
SESSION_TILED_DETECTION=true
SESSION_TILE_MIN_SIZE=1600
SESSION_TILE_OVERLAP=0.2
FACE_NMS_IOU=0.4

# Face quality gates: failures are flagged to the review queue, never
# silently dropped and never auto-matched.
FACE_MIN_SIZE_PX=50        # min bbox width AND height in pixels
FACE_MIN_BLUR_VAR=50.0     # Laplacian variance (lower = blurrier)
FACE_MAX_POSE_RATIO=0.45   # eye-to-nose asymmetry (extreme profiles)

# Multi-frame burst capture: 1-5 frames per session.
CAPTURE_MAX_FRAMES=5

# Minimum shorter-side resolution for session photos (px). Back-row faces
# need ~1024px+ to be recognisable — lower-res uploads are rejected with 422.
# Set 0 to disable the floor.
CAPTURE_MIN_IMAGE_SIDE=1024

# ── Uploads ───────────────────────────────────────────────────────────────────
# Max accepted image size in bytes (default 10 MB)
UPLOAD_MAX_BYTES=10485760
ENROLLMENT_MIN_IMAGES=3
ENROLLMENT_MAX_IMAGES=5

# ── Job status (Redis) ────────────────────────────────────────────────────────
# How long capture-job status/result entries live in Redis
JOB_STATUS_TTL_SECONDS=3600

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requests per minute per IP on auth endpoints
RATE_LIMIT_AUTH_RPM=10
# Capture jobs per admin per minute (per section)
RATE_LIMIT_CAPTURE_RPM=5

# ── Environment tag ──────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
