# ─────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# NEVER commit .env or any file containing real secrets to source control.
# In production, all secrets are pulled from Azure Key Vault via managed
# identity — this file is purely for local docker-compose / direct-run usage.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Full DSN for async SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://attendance:attendance@localhost:5432/attendance_db

# Sync DSN used by Alembic migrations only
DATABASE_URL_SYNC=postgresql+psycopg2://attendance:attendance@localhost:5432/attendance_db

# Async SQLAlchemy connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_random_hex_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Queue backend ─────────────────────────────────────────────────────────────
# "redis"         — local dev (uses Redis List via LPUSH/BRPOP)
# "servicebus"    — production (requires SERVICE_BUS_CONNECTION_STRING)
QUEUE_BACKEND=redis
QUEUE_NAME=capture-jobs

# Azure Service Bus (leave blank for local dev)
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_NAMESPACE=

# ── Storage backend ───────────────────────────────────────────────────────────
# "local"         — stores files under STORAGE_LOCAL_ROOT (for local dev)
# "azure_blob"    — production (requires AZURE_STORAGE_CONNECTION_STRING)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/data/uploads

# Azure Blob Storage (leave blank for local dev)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_ENROLLMENT=enrollment-images
AZURE_BLOB_CONTAINER_SESSIONS=session-images

# ── Azure Key Vault (production only) ─────────────────────────────────────────
# Managed identity must have "Key Vault Secrets User" role on this vault.
AZURE_KEYVAULT_URI=

# ── Face pipeline ─────────────────────────────────────────────────────────────
# Cosine distance threshold (0-2 scale). Values below this are a match.
# Calibrate with scripts/calibrate_threshold.py — default is conservative.
FACE_MATCH_THRESHOLD=0.45

# Max faces expected in a single classroom photo (guard against runaway loops)
FACE_DETECTION_MAX_FACES=100

# InsightFace model pack name (buffalo_l = RetinaFace + ArcFace 512-d)
INSIGHTFACE_MODEL_PACK=buffalo_l

# ── Uploads ───────────────────────────────────────────────────────────────────
# Max accepted image size in bytes (default 10 MB)
UPLOAD_MAX_BYTES=10485760
ENROLLMENT_MIN_IMAGES=3
ENROLLMENT_MAX_IMAGES=5

# ── Job status (Redis) ────────────────────────────────────────────────────────
# How long capture-job status/result entries live in Redis
JOB_STATUS_TTL_SECONDS=3600

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requests per minute per IP on auth endpoints
RATE_LIMIT_AUTH_RPM=10
# Capture jobs per admin per minute (per section)
RATE_LIMIT_CAPTURE_RPM=5

# ── Environment tag ──────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
